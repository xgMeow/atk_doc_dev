{
	"name": "atk-doc",
	"version": "4.0.1",
	"description": "ATK 帮助文档 — 加快工业软件国产化，服务航天强国建设",
	"license": "MIT",
	"scripts": {
		"update-package": "npx vp-update",
		"dev": "vuepress dev src",
		"dev:clean": "vuepress dev src --clean-cache",
		"dev:gitlab": "vuepress dev --config src/.vuepress/config-gitlab.ts src",
		"dev-debug": "vuepress dev --debug src",
		"build:online": "vuepress build --config src/.vuepress/config-online.ts --dest .dist/online src",
		"build:standalone": "vuepress build --config src/.vuepress/config-standalone.ts --dest .dist/standalone src && npm run script:standalone",
		"build:standalone-kylin": "vuepress build --config src/.vuepress/config-standalone-kylin.ts --dest .dist/standalone-kylin src && npm run script:standalone-kylin",
		"export:word": "node scripts/export-word.cjs",
		"script:standalone": "node src/.vuepress/standalone.cjs .dist/standalone",
		"script:standalone-kylin": "node src/.vuepress/standalone.cjs .dist/standalone-kylin",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@vuepress/bundler-vite": "2.0.0-rc.9",
		"@vuepress/bundler-webpack": "^2.0.0-rc.9",
		"@vuepress/plugin-redirect": "^2.0.0-rc.26",
		"@vuepress/plugin-rtl": "^2.0.0-rc.26",
		"@vuepress/plugin-search": "^2.0.0-rc.26",
		"css": "^3.0.0",
		"is-absolute-url": "^3.0.3",
		"is-url": "^1.2.4",
		"katex": "^0.16.10",
		"mathjax-full": "^3.2.2",
		"node-fetch": "^3.3.2",
		"sass-loader": "^14.2.1",
		"vue": "^3.4.23",
		"vuepress": "^2.0.0-rc.9",
		"vuepress-plugin-search-pro": "^2.0.0-rc.37",
		"vuepress-theme-hope": "2.0.0-rc.37",
		"walk": "^2.3.15"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"@mdit/plugin-include": "^0.23.2",
		"@vue/babel-preset-app": "^5.0.9",
		"babel-loader": "^10.0.0",
		"patch-package": "^8.0.1"
	},
	"browerslist": [
		"> 1%",
		"last 2 version",
		"not ie <= 8",
		"firefox >= 52"
	]
}
