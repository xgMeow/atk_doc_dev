+function url_relative(from, absurl)
+{
+  let relurl = path.relative(from, absurl)
+  if(absurl.endsWith("\\") || absurl.endsWith("/")){
+    relurl = path.join(relurl, "index.html");
+  }
+  relurl = relurl.replace(/\\/g, "/");
+  // console.log(from, absurl, relurl)
+  return relurl;
+}
+
